{
  "name": "tether-duo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/server dev",
    "start": "bun run --cwd packages/server start",
    "server:dev": "bun run --cwd packages/server dev",
    "server:start": "bun run --cwd packages/server start",
    "mobile:start": "bun run --cwd packages/mobile start",
    "mobile:web": "bun run --cwd packages/mobile web",
    "build:shared": "bun run --cwd packages/shared build",
    "build:web": "bun run --cwd packages/mobile build:web",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/server --noEmit && tsc -p packages/mobile --noEmit",
    "test": "bun test",
    "smoke": "bun run test-two-players.ts"
  }
}
