# Port and bind address for the game server (defaults: 3001 / 0.0.0.0)
PORT=3001
HOST=0.0.0.0

# Passphrase both players must enter (Settings) to join matchmaking.
# Empty string disables the check — not recommended for public servers.
PAIRING_SECRET=change-me-to-a-shared-passphrase

# Allowed CORS origin for the web client. Use the site URL in production
# (e.g. https://tether.example.com), or * for local development.
CORS_ORIGIN=*

# How long an opponent can be offline before the room is closed (ms)
RECONNECTION_GRACE_PERIOD_MS=60000

# Per-turn time limit for the hangman-style game (seconds)
TURN_TIMEOUT_SECONDS=45
