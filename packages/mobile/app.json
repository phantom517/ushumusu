{
  "expo": {
    "name": "musu",
    "slug": "musu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tether",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ansurijal.musu",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "521975dc-d6b1-4eeb-8a69-354f89e2c02a"
      }
    },
    "owner": "ansurijal"
  }
}
